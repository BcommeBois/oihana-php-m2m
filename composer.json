{
    "name" : "oihana/php-m2m" ,
    "type" : "library" ,
    "description" : "Lightweight, OIDC-compliant Machine-to-Machine (M2M) HTTP client for APIs protected by JWT — implements the OAuth 2.0 jwt-bearer flow (RFC 7521 + RFC 7523)." ,
    "keywords" : [
        "php" ,
        "m2m" ,
        "machine-to-machine" ,
        "oauth2" ,
        "oidc" ,
        "jwt" ,
        "jwt-bearer" ,
        "client-credentials" ,
        "api-client" ,
        "zitadel"
    ] ,
    "homepage" : "https://github.com/BcommeBois/oihana-php-m2m" ,
    "license" : "MPL-2.0" ,
    "authors" : [
        {
            "name"     : "Marc Alcaraz" ,
            "email"    : "marc@ooop.fr" ,
            "homepage" : "https://www.ooop.fr" ,
            "role"     : "Project Founder, Lead Developer."
        }
    ] ,
    "support" : {
        "email"  : "marc@ooop.fr" ,
        "issues" : "https://github.com/BcommeBois/oihana-php-m2m/issues" ,
        "source" : "https://github.com/BcommeBois/oihana-php-m2m"
    } ,
    "scripts" : {
        "doc"  : "rm -rf docs && mkdir docs && cp -r assets docs/assets && ./vendor/bin/phpdoc -c phpdoc.xml -v" ,
        "test" : "./vendor/bin/phpunit"
    } ,
    "autoload" : {
        "psr-4" : {
            "oihana\\m2m\\" : "src/oihana/m2m"
        }
    } ,
    "autoload-dev" : {
        "psr-4" : {
            "tests\\oihana\\m2m\\" : "tests/oihana/m2m"
        }
    } ,
    "require" : {
        "php"               : ">=8.4" ,
        "ext-json"          : "*" ,
        "firebase/php-jwt"  : "^7.0" ,
        "guzzlehttp/guzzle" : "^7.8" ,
        "oihana/php-enums"  : "dev-main" ,
        "oihana/php-files"  : "dev-main" ,
        "oihana/php-schema" : "dev-main"
    } ,
    "require-dev" : {
        "ext-xdebug"             : "*" ,
        "phpunit/phpunit"        : "^12" ,
        "nunomaduro/collision"   : "^8.8" ,
        "phpdocumentor/shim"     : "^3.8"
    } ,
    "minimum-stability" : "dev" ,
    "prefer-stable" : true ,
    "config" : {
        "allow-plugins" : {
            "phpdocumentor/shim" : true
        }
    }
}
