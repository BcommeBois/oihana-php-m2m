{
    "name" : "oihana/php-m2m" ,
    "type" : "library" ,
    "description" : "Lightweight, OIDC-compliant Machine-to-Machine (M2M) HTTP client for APIs protected by JWT — implements the OAuth 2.0 jwt-bearer flow (RFC 7521 + RFC 7523). PHP 7.4 compatibility branch." ,
    "keywords" : [
        "php" ,
        "php74" ,
        "m2m" ,
        "machine-to-machine" ,
        "oauth2" ,
        "oidc" ,
        "jwt" ,
        "jwt-bearer" ,
        "client-credentials" ,
        "api-client" ,
        "zitadel"
    ] ,
    "homepage" : "https://github.com/BcommeBois/oihana-php-m2m" ,
    "license" : "MPL-2.0" ,
    "authors" : [
        {
            "name"     : "Marc Alcaraz" ,
            "email"    : "marc@ooop.fr" ,
            "homepage" : "https://www.ooop.fr" ,
            "role"     : "Project Founder, Lead Developer."
        }
    ] ,
    "support" : {
        "email"  : "marc@ooop.fr" ,
        "issues" : "https://github.com/BcommeBois/oihana-php-m2m/issues" ,
        "source" : "https://github.com/BcommeBois/oihana-php-m2m"
    } ,
    "scripts" : {
        "test" : "./vendor/bin/phpunit"
    } ,
    "autoload" : {
        "psr-4" : {
            "oihana\\m2m\\" : "src/oihana/m2m"
        }
    } ,
    "autoload-dev" : {
        "psr-4" : {
            "tests\\oihana\\m2m\\" : "tests/oihana/m2m"
        }
    } ,
    "require" : {
        "php"               : ">=7.4" ,
        "ext-json"          : "*" ,
        "ext-openssl"       : "*" ,
        "guzzlehttp/guzzle" : "^7.5"
    } ,
    "require-dev" : {
        "phpunit/phpunit"      : "^9.6" ,
        "nunomaduro/collision" : "^5.11"
    } ,
    "minimum-stability" : "stable" ,
    "prefer-stable" : true
}
